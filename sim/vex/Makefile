# xcelium simulation of hw/cluster/tops/u55_vex_top.sv with the sw/test.c payload
# (bootrom and VexRiscvU55 generated by make sim-vex in the repo root)
#   make            build the payload, compile and run
#   make GUI=1      same, with simvision

REPO        := $(abspath ../..)
BUILD_DIR   ?= $(REPO)/build/sim-vex
VEX_RTL     ?= $(REPO)/build/sim-vex/vexriscv/VexRiscvU55.v
BOOTROM     ?= $(REPO)/build/sim-vex/bootrom/bootrom_vex.sv
CROSSCOMPILE ?= riscv64-unknown-elf-
PYTHON      ?= python3
XRUN        ?= xrun
VIVADO_ROOT ?= $(abspath $(dir $(shell which vivado))/..)
GUI         ?= 0

SW_CFLAGS   = -Os -g -march=rv32im_zicsr_zifencei -mabi=ilp32 -Wall -nostdlib -nostartfiles \
              -I$(REPO)/bootrom_u55/src
SW_SRCS     = sw/crt0.S sw/test.c $(REPO)/bootrom_u55/src/uart.c

XRUN_FLAGS  = -64bit -sv -v93 -timescale 1ns/1ps -access +rwc -licqueue \
              -xmlibdirpath $(BUILD_DIR) \
              -y $(VIVADO_ROOT)/data/verilog/src/unisims +libext+.v \
              -top tb_vex -top glbl
ifeq ($(GUI),1)
XRUN_FLAGS += -gui
endif

.PHONY: run clean

run: $(BUILD_DIR)/test.hex $(BUILD_DIR)/vex.f
	cd $(BUILD_DIR) && $(XRUN) $(XRUN_FLAGS) -l xrun.log \
		-f $(BUILD_DIR)/vex.f \
		$(abspath ../models/hbm_interface_sim.sv ../models/xlnx_clk_gen_sim.sv tb_vex.sv) \
		$(VIVADO_ROOT)/data/verilog/src/glbl.v \
		+DRAM_HEX=$(BUILD_DIR)/test.hex
	@grep -q "\[tb_vex\] tohost.*PASS" $(BUILD_DIR)/xrun.log

# rtl sources with absolute paths
$(BUILD_DIR)/vex.f: $(REPO)/tcl_scripts/filelists/gen_filelist.py $(VEX_RTL) $(BOOTROM)
	mkdir -p $(BUILD_DIR)
	$(PYTHON) -I $(word 1,$^) vex --bootrom $(BOOTROM) --vex-rtl $(VEX_RTL) | sed -e 's#^+incdir+\([^/]\)#+incdir+$(REPO)/\1#' -e '/^[^+/]/s#^#$(REPO)/#' > $@

$(BUILD_DIR)/test.elf: $(SW_SRCS) sw/link.ld
	mkdir -p $(BUILD_DIR)
	$(CROSSCOMPILE)gcc $(SW_CFLAGS) -Tsw/link.ld $(SW_SRCS) -lgcc -o $@
	$(CROSSCOMPILE)objdump -d $@ > $(BUILD_DIR)/test.dump

# DRAM 0x8000_0000 is HBM address 0x0
$(BUILD_DIR)/test.hex: $(BUILD_DIR)/test.elf
	$(CROSSCOMPILE)objcopy -O verilog --change-addresses=-0x80000000 $< $@

clean:
	rm -rf $(BUILD_DIR)
