# xcelium simulation of hw/cluster/tops/u55_mini_top.sv with the sw/test.c payload
# (bootrom and riscv-mini Tile generated by make sim-mini in the repo root)
#   make            build the payload, compile and run
#   make GUI=1      same, with simvision

REPO        := $(abspath ../..)
BUILD_DIR   ?= $(REPO)/build/sim-mini
MINI_RTL    ?= $(REPO)/build/sim-mini/riscv_mini/Tile.sv
BOOTROM     ?= $(REPO)/build/sim-mini/bootrom/bootrom_mini.sv
CROSSCOMPILE ?= riscv64-unknown-elf-
PYTHON      ?= python3
XRUN        ?= xrun
VIVADO_ROOT ?= $(abspath $(dir $(shell which vivado))/..)
GUI         ?= 0

SW_CFLAGS   = -Os -g -march=rv32i_zicsr -mabi=ilp32 -Wall -nostdlib -nostartfiles
SW_SRCS     = sw/crt0.S sw/test.c

XRUN_FLAGS  = -64bit -sv -v93 -timescale 1ns/1ps -access +rwc -licqueue \
              -xmlibdirpath $(BUILD_DIR) \
              -y $(VIVADO_ROOT)/data/verilog/src/unisims +libext+.v \
              -top tb_mini -top glbl
ifeq ($(GUI),1)
XRUN_FLAGS += -gui
endif

.PHONY: run clean

run: $(BUILD_DIR)/test.hex $(BUILD_DIR)/mini.f
	cd $(BUILD_DIR) && $(XRUN) $(XRUN_FLAGS) -l xrun.log \
		-f $(BUILD_DIR)/mini.f \
		$(abspath ../models/hbm_interface_sim.sv ../models/xlnx_clk_gen_sim.sv tb_mini.sv) \
		$(VIVADO_ROOT)/data/verilog/src/glbl.v \
		+DRAM_HEX=$(BUILD_DIR)/test.hex
	@grep -q "PASS" $(BUILD_DIR)/xrun.log

# rtl sources with absolute paths
$(BUILD_DIR)/mini.f: $(REPO)/tcl_scripts/filelists/gen_filelist.py $(MINI_RTL) $(BOOTROM)
	mkdir -p $(BUILD_DIR)
	$(PYTHON) -I $(word 1,$^) mini --bootrom $(BOOTROM) --mini-rtl $(MINI_RTL) | sed -e 's#^+incdir+\([^/]\)#+incdir+$(REPO)/\1#' -e '/^[^+/]/s#^#$(REPO)/#' > $@

$(BUILD_DIR)/test.elf: $(SW_SRCS) sw/link.ld
	mkdir -p $(BUILD_DIR)
	$(CROSSCOMPILE)gcc $(SW_CFLAGS) -Tsw/link.ld $(SW_SRCS) -lgcc -o $@
	$(CROSSCOMPILE)objdump -d $@ > $(BUILD_DIR)/test.dump

# DRAM 0x8000_0000 is HBM address 0x0
$(BUILD_DIR)/test.hex: $(BUILD_DIR)/test.elf
	$(CROSSCOMPILE)objcopy -O verilog --change-addresses=-0x80000000 $< $@

clean:
	rm -rf $(BUILD_DIR)
