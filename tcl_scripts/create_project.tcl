# Description: creates the Alveo u55c Vivado project of one of the cores
# Usage: vivado -mode batch -source tcl_scripts/create_project.tcl -tclargs <snitch|cva6|veer|mini> <build_dir> <filelist> [core_mhz cluster_mhz periph_mhz]
#        the filelist is generated by tcl_scripts/filelists/gen_filelist.py (see the Makefile)
# Author: Andrea Motta

set repo [file normalize [file join [file dirname [info script]] ..]]
lassign $argv core build_dir flist core_freq_mhz cluster_freq_mhz periph_freq_mhz
foreach f {core_freq_mhz cluster_freq_mhz periph_freq_mhz} {
    if {[set $f] eq ""} { set $f 50 }
}

array set top_module {
    snitch snitch_u55_xilinx_bd
    cva6   cva6_u55_xilinx_bd
    veer   veer_u55_xilinx_bd
    mini   mini_u55_xilinx_bd
}
if {![info exists top_module($core)]} {
    error "unknown core <$core>, expected one of: [array names top_module]"
}

create_project u55_$core $build_dir -part xcu55c-fsvh2892-2L-e -force
set_property board_part xilinx.com:au55c:part0:1.0 [current_project]
set_property target_language Verilog [current_project]

# -----------------
# RTL sources
# -----------------
# filelist: +incdir+<dir>, "// global includes" section, "// sources" section;
# paths relative to the repo root
set incdirs {}
set headers {}
set sources {}
set section sources
set fh [open $flist r]
foreach line [split [read $fh] "\n"] {
    set line [string trim $line]
    if {$line eq "// global includes"} { set section headers; continue }
    if {$line eq "// sources"}         { set section sources; continue }
    if {$line eq "" || [string match "//*" $line]} continue
    if {[string match "+incdir+*" $line]} {
        lappend incdirs [file join $repo [string range $line 8 end]]
    } else {
        lappend $section [file join $repo $line]
    }
}
close $fh

add_files -norecurse -fileset sources_1 [concat $headers $sources]
# .v files of the filelist use SystemVerilog syntax (e.g. VeeR dmi), as in simulation
foreach f $sources {
    if {[file extension $f] eq ".v"} {
        set_property file_type SystemVerilog [get_files $f]
    }
}
foreach f $headers {
    set_property file_type {Verilog Header} [get_files $f]
    set_property is_global_include true [get_files $f]
}
set_property include_dirs $incdirs [get_filesets sources_1]
set_property verilog_define {TARGET_FPGA TARGET_XILINX TARGET_VIVADO TARGET_SYNTHESIS FPGA_TARGET_XILINX} [get_filesets sources_1]

# reset checker referenced as module by the qdma/hbm block design
add_files -norecurse -fileset sources_1 [file join $repo hw/cluster/xdma_boot/axi4_boot_check.v]

# -----------------
# IPs and block design
# -----------------
source [file join $repo tcl_scripts/gen_clock.tcl]
source [file join $repo tcl_scripts/qdma_interface.tcl]
if {[get_files -quiet hbm_interface.bd] eq ""} {
    error "block design hbm_interface was not created, see the qdma_interface.tcl messages above"
}
# the compute side hbm channels run at the clock of their cluster crossbar
# (the S*_AXI_0 interfaces inherit it from their axi_clk_cluster_* port)
set cluster_freq_hz [expr {int($cluster_freq_mhz * 1000000)}]
set_property CONFIG.FREQ_HZ $cluster_freq_hz [get_bd_ports axi_clk_cluster_*]
validate_bd_design
save_bd_design

# -----------------
# Constraints
# -----------------
add_files -norecurse -fileset constrs_1 [file join $repo xdc/u55/u55_snitch_const.xdc]
# clock domain crossings between core, cluster and peripheral clocks (tcl: needs the clock periods)
add_files -norecurse -fileset constrs_1 [file join $repo xdc/u55/u55_clock_domains.tcl]
set_property USED_IN_SYNTHESIS false [get_files u55_clock_domains.tcl]

set_property top $top_module($core) [get_filesets sources_1]
update_compile_order -fileset sources_1

puts "INFO: created [current_project] in $build_dir, top $top_module($core), clocks core $core_freq_mhz, cluster $cluster_freq_mhz, peripherals $periph_freq_mhz MHz"
close_project
